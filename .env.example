# =============================================================================
# KickData environment variables
# =============================================================================
# We split environments into dev / prod. Create TWO local files from this
# template (both are gitignored via `.env*.local`):
#
#   .env.development.local  -> used by `npm run dev` and `npm run db:migrate:dev`
#   .env.production.local   -> used by `npm run db:migrate:prod`
#
# On Vercel, set these same vars in Project Settings and scope them:
#   Production            -> prod Neon branch values
#   Preview + Development -> dev  Neon branch values
#
# APP_ENV / VERCEL_ENV are derived automatically — do NOT set them by hand.
# =============================================================================

# --- Database (Neon serverless Postgres) ---
# One Neon project, two branches:
#   dev  file -> "development" branch connection string
#   prod file -> "production" (main) branch connection string
# Use the POOLED connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/kickdata?sslmode=require"

# --- iSportsAPI ---
# Get an API key from https://www.isportsapi.com/
ISPORTS_API_KEY="your-isports-api-key"
ISPORTS_BASE_URL="http://api.isportsapi.com/sport/football"

# --- Cron protection (min 16 chars) ---
# Vercel Cron sends this automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="generate-a-long-random-string"

# --- Docs demo key ---
# A real API key (issue one with `npm run key:create`) pre-filled in the /docs
# Try-it client. NEXT_PUBLIC_ = exposed to the browser on purpose (it's a demo).
NEXT_PUBLIC_DEMO_API_KEY="kd_..."
