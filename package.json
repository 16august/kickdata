{
  "name": "kickdata",
  "version": "0.1.0",
  "private": true,
  "description": "KickData — free football data API with subscription tiers, backed by iSportsAPI",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.development.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.development.local -- drizzle-kit studio",
    "seed:leagues": "dotenv -e .env.development.local -- tsx scripts/seed-leagues.ts",
    "seed:leagues:prod": "dotenv -e .env.production.local -- tsx scripts/seed-leagues.ts",
    "seed:teams": "dotenv -e .env.development.local -- tsx scripts/seed-teams.ts",
    "seed:teams:prod": "dotenv -e .env.production.local -- tsx scripts/seed-teams.ts",
    "seed:fixtures": "dotenv -e .env.development.local -- tsx scripts/seed-fixtures.ts",
    "seed:fixtures:prod": "dotenv -e .env.production.local -- tsx scripts/seed-fixtures.ts",
    "seed:players": "dotenv -e .env.development.local -- tsx scripts/seed-players.ts",
    "seed:players:prod": "dotenv -e .env.production.local -- tsx scripts/seed-players.ts",
    "key:create": "dotenv -e .env.development.local -- tsx scripts/create-key.ts",
    "key:create:prod": "dotenv -e .env.production.local -- tsx scripts/create-key.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@scalar/nextjs-api-reference": "^0.11.11",
    "drizzle-orm": "^0.38.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
